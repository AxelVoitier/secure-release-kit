#!/usr/bin/env bash
# This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0.
# If a copy of the MPL was not distributed with this file, You can obtain one at https://mozilla.org/MPL/2.0/.
# Test double for gh: `gh api [-X M] PATH [--jq Q] [--paginate] [-f/-F k=v]...` -> $FIX/<M>_<path>.json
set -e -o pipefail
echo "gh $*" >> "${GHLOG:-/tmp/ghlog}"
if [ "$1" = release ] && [ "$2" = verify ]; then
  count_file="$FIX/verify-attempts"
  count=0
  [ ! -f "$count_file" ] || read -r count < "$count_file"
  count=$((count + 1))
  echo "$count" > "$count_file"
  [ -z "${GH_VERIFY_DELAY:-}" ] || sleep "$GH_VERIFY_DELAY"
  if [ "$count" -le "${GH_VERIFY_FAILURES:-0}" ]; then
    echo "fixture release verification: unavailable on attempt $count"
    exit 1
  fi
  echo "fixture release verification: exit ${GH_VERIFY_STATUS:-0}"
  exit "${GH_VERIFY_STATUS:-0}"
fi
if [ "$1" = release ] && [ "$2" = upload ] && [ -n "${GH_UPLOAD_RELEASE_ID:-}" ]; then
  # A hidden second draft can receive uploads selected by tag. Update only that draft's fixture.
  shift 3
  assets='[]'
  while [ $# -gt 0 ] && [ "$1" != --clobber ]; do
    digest=$(sha256sum "$1" | cut -d' ' -f1)
    assets=$(jq --arg name "$1" --arg digest "sha256:$digest" '. + [{name: $name, digest: $digest}]' <<<"$assets")
    shift
  done
  file="$FIX/GET_repos_${GITHUB_REPOSITORY//\//_}_releases_$GH_UPLOAD_RELEASE_ID.json"
  jq --argjson assets "$assets" '.assets = $assets' "$file" > "$file.tmp"
  mv "$file.tmp" "$file"
  exit 0
fi
if [ "$1" = run ] && [ "$2" = download ]; then   # gh run download ID --name N --dir D -> copies $FIX/run-<ID>-<N>/
  run_id=$3
  shift 3
  artifact_name=""
  destination=.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) artifact_name=$2; shift 2 ;;
      --dir) destination=$2; shift 2 ;;
      *) shift ;;
    esac
  done
  source_dir="$FIX/run-$run_id-$artifact_name"
  if [[ ! -d "$source_dir" ]]; then
    echo "gh: no artifact $artifact_name in run $run_id" >&2
    exit 1
  fi
  mkdir -p "$destination"
  cp -r "$source_dir/." "$destination/"
  exit 0
fi

if [[ "$1" != api ]]; then
  echo "unsupported fixture command: gh $*" >&2
  exit 1
fi
shift
method=GET
path=""
query=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -X) method=$2; shift 2 ;;
    --jq) query=$2; shift 2 ;;
    --paginate) shift ;;
    -f|-F) shift 2 ;;
    *) path=$1; shift ;;
  esac
done

fixture="$FIX/${method}_$(printf '%s' "$path" | tr '/?&=' '____').json"
if [[ ! -f "$fixture" ]]; then
  echo "gh: HTTP 404 ($fixture)" >&2
  exit 1
fi
if [[ -n "$query" ]]; then
  jq -rc "$query" "$fixture"
else
  cat "$fixture"
fi
